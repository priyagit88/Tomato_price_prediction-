# =============================================================================
# Dockerfile.frontend - Multi-stage build for Tomato Price Prediction Frontend
# =============================================================================

# --------------- Stage 1: Dependencies ---------------
FROM node:18-alpine AS deps

WORKDIR /app

# Copy package definition files
COPY frontend/package.json frontend/package-lock.json* ./

# Install ALL dependencies (including devDependencies required for tsc and vite build)
RUN npm install

# --------------- Stage 2: Builder ---------------
FROM node:18-alpine AS builder

WORKDIR /app

# Copy dependencies from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy frontend source code
COPY frontend/ ./

# Build the React + TypeScript + Tailwind bundle (outputs to /app/out)
RUN npm run build

# --------------- Stage 3: Production Server ---------------
FROM nginx:alpine AS production

LABEL maintainer="tomato-price-prediction-team"
LABEL description="Tomato Price Prediction Frontend"
LABEL version="1.0.0"

# Remove default nginx html and config
RUN rm -rf /usr/share/nginx/html/* /etc/nginx/conf.d/default.conf

# Copy custom nginx configuration
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built frontend assets from builder stage
COPY --from=builder /app/out /usr/share/nginx/html

# Permissions setup
RUN chown -R nginx:nginx /usr/share/nginx/html \
    && chown -R nginx:nginx /var/cache/nginx \
    && chown -R nginx:nginx /var/log/nginx \
    && touch /var/run/nginx.pid \
    && chown -R nginx:nginx /var/run/nginx.pid

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/nginx-health || exit 1

CMD ["nginx", "-g", "daemon off;"]
