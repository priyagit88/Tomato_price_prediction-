# =============================================================================
# .dockerignore - Exclude unnecessary files from Docker build context
# =============================================================================

# Version control
.git
.gitignore

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/
.coverage
.tox/
.nox/
venv/
.venv/
env/
.env

# Node.js (for frontend)
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Terraform
terraform/
*.tfstate
*.tfstate.*
.terraform/
*.tfvars

# CI/CD
azure-pipelines*.yml
.github/

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore

# Documentation
*.md
LICENSE
docs/

# Environment and secrets
.env
.env.*
!.env.example

# Data files (large - mount as volumes instead)
data/raw/*.csv
data/processed/*.csv
data/predictions/*.csv

# Logs
logs/
*.log

# Temporary files
tmp/
temp/
scratch/

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints/
